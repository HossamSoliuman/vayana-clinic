{
  "permissions": {
    "allow": [
      "mcp__laravel-boost__database-schema",
      "mcp__laravel-boost__application-info",
      "Bash(php artisan *)",
      "PowerShell(php artisan make:seeder ProviderSeeder --no-interaction)",
      "PowerShell(php artisan migrate:fresh --seed --no-interaction)",
      "mcp__laravel-boost__database-query",
      "PowerShell(vendor/bin/pint --dirty --format agent)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}
